# Woyuqe — пример конфига окружения. Скопируй в .env и впиши СВОИ значения.
# cp .env.example .env
# ВНИМАНИЕ: реальные значения писать ТОЛЬКО в .env (он в .gitignore).
# Этот файл (.env.example) попадает в git — здесь только заглушки!

# ── Telegram ──────────────────────────
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Твой chat_id (или несколько через запятую) — кому разрешён доступ.
AUTHORIZED_CHAT_IDS=YOUR_TELEGRAM_CHAT_ID

# ── LLM (OpenRouter) ──────────────────
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXX
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Mini App (веб-интерфейс) ──────────
# HTTPS-адрес развёрнутого интерфейса (GitHub Pages / Vercel / VPS).
# Примеры: https://maxxlus.github.io/ | https://woyuqe.vercel.app/ | https://твой-домен/app/
WEBAPP_URL=https://woyuqe-github-io-three.vercel.app/

# ⚠️ ТОЛЬКО для локальной отладки без Telegram. В проде оставить ПУСТЫМ!
WEBAPP_DEV_CHAT_ID=

# ── Прочее ────────────────────────────
BACKEND_URL=ws://localhost:8000
REMINDER_CHECK_INTERVAL=60
